{
  "name": "clearev",
  "version": "0.1.0",
  "private": true,
  "description": "ClearEV: discover live US EV, charging, solar, home battery, utility, and company savings programs.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "geo:build": "tsx scripts/build-geo.ts && tsx scripts/build-county-points.ts",
    "ingest": "tsx scripts/ingest.ts",
    "linkcheck": "tsx scripts/linkcheck.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "preview:build": "node preview/snapshot.mjs && node preview/build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "19.2",
    "react-dom": "19.2",
    "sanitize-html": "^2.18.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "hyparquet": "1.31.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "us-zcta-counties": "^0.0.2",
    "us-zip-centroids": "^1.2.0",
    "vitest": "^3.2.7"
  }
}
