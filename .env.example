# ---- Database ----
# Production: a PostgreSQL connection string (Neon, Supabase, RDS, ...). Leave unset locally to use embedded PGlite.
DATABASE_URL=
# Where embedded PGlite stores data when DATABASE_URL is unset (default .data/pglite)
PGLITE_DIR=
# Set to "true" to run SQL migrations automatically on first use against DATABASE_URL (otherwise run `npm run db:migrate`)
AUTO_MIGRATE=false

# ---- Data sources (server-side only; never shipped to the browser) ----
# api.data.gov key, used for NREL AFDC Laws & Incentives and OpenEI URDB. Free: https://developer.nrel.gov/signup/
NREL_API_KEY=
# Rewiring America Incentives API key. Free: https://docs.rewiringamerica.org/signin
REWIRING_AMERICA_API_KEY=
# Cache windows for on-demand sources (hours). Rewiring America terms cap caching at 24 hours.
RA_CACHE_HOURS=24
OPENEI_CACHE_HOURS=168
# Random string used to salt hashed cache keys (so income values cannot be recovered from keys)
CACHE_SALT=change-me-to-a-random-string
# Minimum milliseconds between requests to the same source host
SOURCE_MIN_INTERVAL_MS=1000

# ---- Scheduled refresh ----
# Bearer token required by /api/cron/refresh and /api/cron/linkcheck (Vercel Cron sends it automatically when set)
CRON_SECRET=

# ---- Admin ----
# Output of `npm run admin:hash -- 'your password'`
ADMIN_PASSWORD_HASH=
# 32+ random characters; signs the admin session cookie
ADMIN_SESSION_SECRET=
